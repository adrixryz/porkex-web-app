# Copy to .env and fill in your own values.
#
# This file is committed on purpose: it documents which variables exist and what
# shape they take, without carrying any real value. The matching .env is ignored.

# Origin of the API.
#
# Leave it empty for local development: the Vite dev server and `vite preview`
# both proxy /api and /auth to the backend (see vite.config.ts), so the browser
# only ever talks to one origin and CORS never comes into play.
#
# Set it to the API origin when the two are deployed as separate services, e.g.
#   VITE_API_BASE="https://porkex-api.onrender.com"
#
# Note: Vite bakes this value into the bundle at build time. Changing it later
# means rebuilding the frontend, not just restarting it.
VITE_API_BASE=""
